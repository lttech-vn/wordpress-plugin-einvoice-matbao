{
	"name": "lttech-vn/einvoice-matbao",
	"description": "Tạo hóa đơn GTGT nháp trên Mắt Bão cho đơn hàng WooCommerce đã hoàn thành.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.2",
		"sentry/sentry": "^4.36"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/woocommerce-stubs": "^11.2",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.3",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.4",
		"wp-phpunit/wp-phpunit": "~7.1.0",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"autoload": {
		"psr-4": {
			"LTTech\\EinvoiceMatbao\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"LTTech\\EinvoiceMatbao\\Tests\\": "tests/",
			"LTTech\\EinvoiceMatbao\\Tests\\Integration\\": "tests/integration/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"platform": {
			"php": "8.2.0"
		},
		"sort-packages": true,
		"platform-check": false
	},
	"scripts": {
		"lint": "phpcs",
		"analyse": "phpstan analyse --memory-limit=1G",
		"analyse:floor-guard": "out=$(phpstan analyse --memory-limit=1G --no-progress --error-format=raw tests/fixtures/php-floor 2>&1); status=$?; if [ \"$status\" -ne 0 ] && printf '%s' \"$out\" | grep -q json_validate; then echo 'Floor guard OK: json_validate rejected under PHP 8.2.'; else echo \"Floor guard FAILED (phpstan exit $status):\"; echo \"$out\"; exit 1; fi",
		"test:integration": "phpunit -c phpunit.xml.dist",
		"test:without-woocommerce": "phpunit -c phpunit-without-woocommerce.xml.dist",
		"test": [
			"@test:integration",
			"@test:without-woocommerce"
		],
		"check": [
			"@lint",
			"@analyse",
			"@analyse:floor-guard",
			"@test"
		]
	}
}
