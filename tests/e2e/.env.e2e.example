# Copy to .env.e2e.local (gitignored). Never commit real values.
# Jev decision model needs provider + key; without them the config falls back to a local Ollama.
E2E_SYSTEMONE_PROVIDER=jev
E2E_SYSTEMONE_API_KEY=
# E2E_SYSTEMONE_BASE_URL=https://api.typesafe.ai/v1
# E2E_SYSTEMONE_MODEL=jev-latest

# Text model (OpenAI-compatible). The URL must be reachable from the browser container.
E2E_TEXT_BASE_URL=http://<reachable-host>:20128/v1
E2E_TEXT_MODEL=gpt-6-luna
E2E_TEXT_API_KEY=

# Real Mat Bao demo (drafts only, never replay/CI): EINV_DEMO_E2E=1 plus EINV_DEMO_MST, EINV_DEMO_USER, EINV_DEMO_PASS.
