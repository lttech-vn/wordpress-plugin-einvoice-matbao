<?xml version="1.0"?>
<!-- Suite with WooCommerce NOT loaded, to prove the plugin deactivates itself without a fatal error. -->
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
	bootstrap="tests/without-woocommerce/bootstrap.php"
	colors="true"
	beStrictAboutOutputDuringTests="true"
	failOnRisky="true"
	failOnWarning="true"
>
	<testsuites>
		<testsuite name="without-woocommerce">
			<directory suffix="Test.php">tests/without-woocommerce</directory>
		</testsuite>
	</testsuites>
	<php>
		<env name="WP_PHPUNIT__TABLE_PREFIX" value="wptests_nowc_"/>
	</php>
</phpunit>
